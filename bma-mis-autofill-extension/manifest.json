{
  "manifest_version": 3,
  "name": "BMA MIS Auto-Filler • by ARISSARA.K",
  "version": "1.3.1",
  "author": "ARISSARA.K",
  "description": "ส่วนขยายบน Opera/Chrome สำหรับดึงข้อมูลจาก Google Sheets กรอกลงระบบจัดซื้อ/เช่า กทม. (MIS) อัตโนมัติครบ 8 ขั้นตอน • พัฒนาโดย ARISSARA.K",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "http://bmamisapp11.bma.go.th/*",
    "http://bmamisapp11.bma.go.th:7778/*",
    "http://misweb.bma.go.th/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://bmamisapp11.bma.go.th/*",
        "http://bmamisapp11.bma.go.th:7778/*",
        "http://misweb.bma.go.th/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
