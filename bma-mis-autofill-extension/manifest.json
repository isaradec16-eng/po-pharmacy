{
  "manifest_version": 3,
  "name": "BMA MIS Auto-Filler (ระบบกรอกข้อมูลจัดซื้อ/ตรวจรับ รพจ.)",
  "version": "1.1.0",
  "description": "ส่วนขยายบน Opera/Chrome สำหรับดึงข้อมูลจาก Google Sheets (Auto Crat-EGP70 & MISS70) กรอกลงระบบจัดซื้อ/เช่า กทม. (MIS) อัตโนมัติครบทั้ง 7 ขั้นตอน",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://bmamisapp11.bma.go.th/*",
    "http://bmamisapp11.bma.go.th:7778/*",
    "http://misweb.bma.go.th/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://bmamisapp11.bma.go.th/*",
        "http://bmamisapp11.bma.go.th:7778/*",
        "http://misweb.bma.go.th/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
